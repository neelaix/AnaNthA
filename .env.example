# Copy to .env.local and fill in after running `npx convex dev`.
VITE_CONVEX_URL=https://your-deployment.convex.cloud
# Optional; defaults to the same deployment with .convex.site
VITE_CONVEX_SITE_URL=https://your-deployment.convex.site
# Must match VAPID_PUBLIC_KEY set in the Convex deployment environment.
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
